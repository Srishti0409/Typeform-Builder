# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Every value here has a working local default, so a fresh checkout runs without
# this file at all. Deployments set them explicitly.

# ── Database ────────────────────────────────────────────────────────────────
# Defaults to SQLite at backend/teraform.db. A deployment points this at
# Postgres; `postgres://` and `postgresql://` URLs are both accepted and routed
# to psycopg 3 automatically.
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/dbname?sslmode=require

# ── Origins ─────────────────────────────────────────────────────────────────
# Browser origins allowed to call this API — the frontend's, in other words.
# Comma-separated or a JSON array; a trailing slash is trimmed either way.
# Defaults to http://localhost:3000 and http://127.0.0.1:3000.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Where published forms are answerable — used to build the share link. This is
# the frontend's origin, not the API's. Defaults to http://localhost:3000.
# PUBLIC_FORM_BASE_URL=https://your-app.vercel.app

# ── "Create with AI" ────────────────────────────────────────────────────────
# The builder's Add content → Create with AI tab is the only feature that needs
# a key. Without one the tab still opens and explains that it is unconfigured;
# everything else in the app works untouched.
#
# ANTHROPIC_API_KEY is read too, so if the environment already has one you don't
# need to set anything here.
AI_API_KEY=

# Optional overrides.
# AI_MODEL=claude-sonnet-5
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MAX_QUESTIONS=12
# AI_TIMEOUT_SECONDS=60
