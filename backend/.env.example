# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# "Create with AI" in the builder's Add content dialog is the only feature that
# needs any of this. Without a key the tab still opens and explains that it is
# unconfigured; everything else in the app works untouched.

# Your Anthropic API key. ANTHROPIC_API_KEY is read too, so if the environment
# already has one you don't need to set anything here.
AI_API_KEY=

# Optional overrides.
# AI_MODEL=claude-sonnet-5
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_MAX_QUESTIONS=12
# AI_TIMEOUT_SECONDS=60

# Where published forms are answerable — used to build the share link.
# PUBLIC_FORM_BASE_URL=http://localhost:3000
